package converter

import (
	"io"
	"strconv"
	"strings"

	"codeberg.org/readeck/readeck/internal/bookmarks"
	"codeberg.org/readeck/readeck/internal/bookmarks/dataset"

	. "codeberg.org/readeck/readeck/components"
)

type epubViews struct{}

templ (v epubViews) bookmark(b *dataset.Bookmark, resources bookmarks.BookmarkFiles, notes []string, html io.Reader) {
	@templ.Raw(`<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.1//EN" "http://www.w3.org/TR/xhtml11/DTD/xhtml11.dtd">` + "\n")
	<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" lang={ b.Lang }>
		<head>
			<title>{ b.Title }</title>
			@templ.Raw(`<meta http-equiv="Content-Security-Policy" content="default-src 'self' 'unsafe-inline' data:;"/>`)
			@templ.Raw(`<meta http-equiv="Content-Security-Policy" content="connect-src 'none';"/>`)
			@templ.Raw(`<meta http-equiv="Content-Security-Policy" content="script-src 'none';"/>`)
			@templ.Raw(`<meta http-equiv="Content-Security-Policy" content="style-src 'self';"/>`)
			@templ.Raw(`<meta http-equiv="Content-Security-Policy" content="frame-src 'none'; child-src 'none';"/>`)
			@templ.Raw(`<meta http-equiv="Content-Security-Policy" content="media-src 'none';"/>`)
			@templ.Raw(`<link rel="stylesheet" type="text/css" href="./styles/stylesheet.css"/>`)
		</head>
		<body>
			<h1 class="title">{ b.Title }</h1>
			if b.Description != "" {
				<p class="desc">{ b.Description }</p>
			}
			<ul class="info">
				<li>
					if img, ok := resources["icon"]; ok {
						@templ.Raw(S(
							`<img class="icon" alt="" src="%s" width="%d" height="%d" />`,
							img.Name, img.Size[0], img.Size[1],
						))
					}
					<strong>{ Tern(func() bool {return b.SiteName != ""}, b.SiteName, "no site name") }</strong>
				</li>
				if b.Published != nil {
					<li>{ L(ctx).Gettext("Published on %s", Strftime(ctx, *b.Published, "%e %B %Y")) }</li>
				}
				if len(b.Authors) > 0 {
					<li>{ L(ctx).Gettext("By %s", strings.Join(b.Authors, ", ")) }</li>
				}
				<li><a href={ b.URL }>{ b.Domain }</a></li>
				if b.ReadingTime > 0 {
					<li>{ L(ctx).Ngettext("About %d minute read", "About %d minutes read", b.ReadingTime, b.ReadingTime) }</li>
				}
			</ul>
			if img, ok := resources["image"]; ok && (b.DocumentType == "photo" || b.DocumentType == "video") {
				<main class="photo">
					@templ.Raw(S(
						`<img alt="" src="%s" width="%d" height="%d" />`,
						img.Name, img.Size[0], img.Size[1],
					))
				</main>
			}
			if _, ok := b.Files["article"]; ok {
				<main class="content">
					@HTML(html)
				</main>
			}
			if len(notes) > 0 {
				<h2>{ L(ctx).Gettext("Notes") }</h2>
				for i, note := range notes {
					<aside id={ "note" + strconv.Itoa(i+1) } epub:type="footnote">
						<a href={ "#noteref" + strconv.Itoa(i+1) }>{ i+1 }</a>
						{ " " }
						{ note }
					</aside>
				}
			}
			@templ.Raw("<hr/>")
			<table class="info">
				<tr>
					<td>
						@templ.Raw(S(`<img alt="" src="%s" />`, QRCodeB64(b.URL, ColorPrimary, -3)))
					</td>
					<td>
						Saved with <a href="https://readeck.com/">Readeck</a>
						@templ.Raw("<br/>")
						<a href={ b.URL }>{ b.URL }</a>
					</td>
				</tr>
			</table>
		</body>
	</html>
}
