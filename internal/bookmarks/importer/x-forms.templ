}

templ (_ *omnivoreAPIAdapter) Component(form forms.FormBinder) {
	<h1 class="title text-h2">{ L(ctx).Gettext("Import your Omnivore Articles") }</h1>
	<div class="prose mb-8">
		<p>
			{ L(ctx).Gettext(`
				To import your articles from Omnivore, you must first create an API Key in your
    		Omnivore's settings and enter it in the the form below.
			`) }
		</p>
	</div>
	{{ f := form.(*omnivoreAPIAdapterForm) }}
	@formViews{}.form(form) {
		@F.TextField(&f.URL,
			F.Label(L(ctx).Gettext("Omnivore URL")),
			F.Required(true),
			F.Classes("field-h"),
			F.Help(L(ctx).Gettext("URL of your Omnivore homepage")),
		)
		@F.TextField(&f.Token,
			F.Label(L(ctx).Gettext("API Key")),
			F.Required(true),
			F.Classes("field-h"),
		)
		@formViews{}.options(&f.BaseImportForm)
	}
}

templ (_ *pinboardAdapter) Component(form forms.FormBinder) {
	<h1 class="title text-h2">{ L(ctx).Gettext("Import Links from a Pinboard JSON backup file") }</h1>
	<div class="prose mb-8">
		<p>
			{ L(ctx).Gettext(
				"Upload a JSON file obtained from your Pinboard account.",
			) }
		</p>
	</div>
	@formViews{}.fileForm(form.(*FileImportForm))
}

templ (_ *pocketFileAdapter) Component(form forms.FormBinder) {
	<h1 class="title text-h2">{ L(ctx).Gettext("Import your Pocket Articles") }</h1>
	<div class="prose mb-8">
		<p>
			@templ.Raw(L(ctx).Gettext(`
				You can export your articles on Pocket by visiting:<br>
    		<a class="%[1]s" href="%[2]s">%[2]s</a>.
			`,
				"link", "https://getpocket.com/export"))
		</p>
		<p>
			{ L(ctx).Gettext(`
			Upload this file in the form below and Readeck will fetch and save
    	every link found it the file.
		`) }
		</p>
		@Message() {
			{ L(ctx).Gettext(`
				Please note that Pocket does not allow the article content to be exported.
				This could lead to different results in Readeck than what you currently
				see in Pocket.
			`) }
		}
	</div>
	{{ f := form.(*FileImportForm) }}
	@formViews{}.form(f) {
		@F.FiledDropField(&f.Data,
			F.Label(L(ctx).Gettext("File")),
			F.Required(true),
			F.Classes("field-h"),
			F.Help(L(ctx).Gettext("Note: upload the ZIP file directly, not its contents")),
		)
		@formViews{}.options(&f.BaseImportForm)
		{ children... }
	}
}

templ (_ *readwiseAdapter) Component(form forms.FormBinder) {
	<h1 class="title text-h2">{ L(ctx).Gettext("Import Links from Readwise Reader CSV export") }</h1>
	<div class="prose mb-8">
		<p>
			{ L(ctx).Gettext(
				"Upload a CSV file exported from your Readwise Reader account below.",
			) }
		</p>
	</div>
	@formViews{}.fileForm(form.(*FileImportForm))
	<h2 class="mt-8 title text-h3">{ L(ctx).Gettext("Which information is imported") }</h2>
	<div class="prose">
		<ul>
			<li>{ L(ctx).Gettext("Article title, URL, and when it was first saved,") }</li>
			<li>{ L(ctx).Gettext("The archived state of an article,") }</li>
			<li>{ L(ctx).Gettext(`"%s" as Readeck labels,`, "Document tags") }</li>
			<li>{ L(ctx).Gettext(`When a document tag contains "%s", the bookmark will be added to Readeck Favorites.`, "favorite") }</li>
		</ul>
		<p>{ L(ctx).Gettext("What is not imported:") }</p>
		<ul>
			<li>{ L(ctx).Gettext("Article reading progress and seen status,") }</li>
			<li>{ L(ctx).Gettext("Articles forwarded to Readwise Reader by email,") }</li>
			<li>{ L(ctx).Gettext("Uploaded documents such as PDFs or EPUB.") }</li>
		</ul>
	</div>
}

templ (_ *textAdapter) Component(form forms.FormBinder) {
	<h1 class="title text-h2">{ L(ctx).Gettext("Import Links from a Text File") }</h1>
	<div class="prose mb-8">
		<p>
			{ L(ctx).Gettext(`
				Upload a text file that contains one link per line and Readeck will fetch
    		all of them and save them in your bookmark list.
			`) }
		</p>
	</div>
	@formViews{}.fileForm(form.(*FileImportForm))
}

templ (_ *wallabagAdapter) Component(form forms.FormBinder) {
	<h1 class="title text-h2">{ L(ctx).Gettext("Import your Wallabag Articles") }</h1>
	<div class="prose mb-8">
		<p>
			@templ.Raw(L(ctx).Gettext(`
				To import your articles from Wallabag, you must first create an API client
				in Wallabag's <strong>API clients management</strong> menu. This will give you
				a <strong>Client ID</strong> and <strong>Client secret</strong>.
			`))
		</p>
		<p>
			{ L(ctx).Gettext(
				"You can then enter all the necessary information in the form below.",
			) }
		</p>
	</div>
	{{ f := form.(*wallabagAdapterForm) }}
	@formViews{}.form(f) {
		@F.TextField(&f.URL,
			F.Label(L(ctx).Gettext("Wallabag URL")),
			F.Required(true),
			F.Classes("field-h"),
			F.Help(L(ctx).Gettext("URL of your Wallabag homepage")),
		)
		@F.TextField(&f.Username,
			F.Label(L(ctx).Gettext("Username")),
			F.Required(true),
			F.Classes("field-h"),
		)
		@F.PasswordField(&f.Password,
			F.Label(L(ctx).Gettext("Password")),
			F.Required(true),
			F.Classes("field-h"),
			F.InputAttr("autocomplete", "off"),
		)
		@F.TextField(&f.ClientID,
			F.Label(L(ctx).Gettext("Client ID")),
			F.Required(true),
			F.Classes("field-h"),
		)
		@F.TextField(&f.ClientSecret,
			F.Label(L(ctx).Gettext("Client Secret")),
			F.Required(true),
			F.Classes("field-h"),
		)
		@formViews{}.options(&f.BaseImportForm)
	}
}
