	<h1 class="title text-h2">{ L(ctx).Gettext("Import Bookmarks from a Linkwarden export file") }</h1>
	<div class="prose mb-8">
		<p>
			{ L(ctx).Gettext(
				"Upload a JSON file obtained from your Linkwarden app.",
			) }
		</p>
	</div>
