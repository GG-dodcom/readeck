package importer

import (
	"codeberg.org/readeck/readeck/pkg/forms/v2"

	. "codeberg.org/readeck/readeck/components"
	F "codeberg.org/readeck/readeck/components/forms/v2"
)

type formViews struct{}

templ (_ formViews) form(f forms.FormBinder) {
	<form action={ URL(ctx) } method="post" enctype="multipart/form-data">
		@F.Errors(f)
		{ children... }
		<p class="btn-block">
			<button class="btn btn-primary" type="submit">{ L(ctx).Gettext("Import Bookmarks") }</button>
			<a class="ml-auto btn btn-default rounded" href={ URL(ctx, "/bookmarks/import") }>
				{ L(ctx).Gettext("Cancel") }
			</a>
		</p>
	</form>
}

templ (v formViews) fileForm(f *FileImportForm) {
	@v.form(f) {
		@F.FiledDropField(&f.Data,
			F.Label(L(ctx).Gettext("File")),
			F.Required(true),
			F.Classes("field-h"),
		)
		@v.options(&f.BaseImportForm)
		{ children... }
	}
}

templ (v formViews) options(f *BaseImportForm) {
	<h2>{ L(ctx).Gettext("Options") }</h2>
	@F.TextField(&f.Label,
		F.Label(L(ctx).Gettext("Label")),
		F.Classes("field-h"),
		F.Help(L(ctx).Gettext("A label to add to all imported bookmarks")),
	)
	@F.CheckboxField(&f.IgnoreDuplicates,
		F.Label(L(ctx).Gettext("Ignore links already in your bookmarks")),
		F.Classes("field-h"),
	)
	@F.CheckboxField(&f.Archive,
		F.Label(L(ctx).Gettext("Archive all links")),
		F.Classes("field-h"),
		F.Help(L(ctx).Gettext("Moves all links to archive, regardless of their original status")),
	)
	@F.CheckboxField(&f.MarkRead,
		F.Label(L(ctx).Gettext("Mark all links as read")),
		F.Classes("field-h"),
		F.Help(L(ctx).Gettext("Marks all links as read, regardless of their original status")),
	)
}

templ (_ *browserAdapter) Component(form forms.FormBinder) {
	<h1 class="title text-h2">{ L(ctx).Gettext("Import your Browser's Bookmarks") }</h1>
	<div class="prose mb-8">
		<p>
			@templ.Raw(L(ctx).Gettext(`
					In your web browser, export your bookmarks as an HTML file.<br>
					Upload this file in the form below and Readeck will create and fetch
					every bookmark found it the file.
				`))
		</p>
		<ul>
			<li>
				<a href="https://support.mozilla.org/en-US/kb/export-firefox-bookmarks-to-backup-or-transfer">
					{ L(ctx).Gettext("Instructions for Firefox") }
				</a>
			</li>
			<li>
				<a href="https://support.google.com/chrome/answer/96816?hl=en">
					{ L(ctx).Gettext("Instructions for Chrome") }
				</a>
			</li>
		</ul>
	</div>
	{{ f := form.(*browserAdapterForm) }}
	@formViews{}.fileForm(&f.FileImportForm) {
		@F.CheckboxField(&f.LabelsFromTitles,
			F.Label(L(ctx).Gettext("Convert section titles to labels")),
			F.Classes("field-h"),
			F.Help(L(ctx).Gettext("Adds a label on links, based on their section title")),
		)
	}
}

templ (_ *csvAdapter) Component(form forms.FormBinder) {
	<h1 class="title text-h2">{ L(ctx).Gettext("Import Links from a CSV File") }</h1>
	<div class="prose mb-8">
		<p>
			{ L(ctx).Gettext(
				"Upload a CSV file from Instapaper or any CSV that matches the format specified below.",
			) }
		</p>
	</div>
	@formViews{}.fileForm(form.(*FileImportForm))
	<h2 class="mt-8 title text-h3">{ L(ctx).Gettext("CSV Format") }</h2>
	<div class="prose mb-8">
		<p>
			@templ.Raw(L(ctx).Gettext(`
				The uploaded file must contain a first row with the column names. Column names are case
    		insensitive and, except for <code>%s</code>, every column is optional.
			`, "url"))
		</p>
		<p>{ L(ctx).Gettext("Here are the columns you can set:") }</p>
		<table>
			<thead>
				<tr>
					<th>{ L(ctx).Gettext("Field") }</th>
					<th>{ L(ctx).Gettext("Alias") }</th>
					<th>{ L(ctx).Gettext("Description") }</th>
				</tr>
			</thead>
			<tbody>
				<tr>
					<td><code>url</code> (<strong>{ L(ctx).Gettext("Required") }</strong>)</td>
					<td></td>
					<td>{ L(ctx).Gettext("Link address") }</td>
				</tr>
				<tr>
					<td><code>title</code></td>
					<td></td>
					<td>{ L(ctx).Gettext("Bookmark title") }</td>
				</tr>
				<tr>
					<td><code>state</code></td>
					<td><code>folder</code></td>
					<td>{ L(ctx).Gettext(`Bookmark's archived state; only valid value is "%s"`, "archive") }</td>
				</tr>
				<tr>
					<td><code>created</code></td>
					<td><code>timestamp</code></td>
					<td>{ L(ctx).Gettext("Creation date, can be a UNIX timestamp or an RFC-3339 formatted date") }</td>
				</tr>
				<tr>
					<td><code>labels</code></td>
					<td><code>tags</code></td>
					<td>{ L(ctx).Gettext("A JSON encoded list of labels") }</td>
				</tr>
			</tbody>
		</table>
		<h4>{ L(ctx).Gettext("Example") }</h4>
		<pre>
			{ "url,title,state,created,labels\n" +
			 `https://www.the-reframe.com/all-in-the-same-boat/,"All In The Same Boat",,2025-01-12T10:45:56,"[""label 1"",""label 2""]"` }
		</pre>
	</div>
}

templ (_ *goodlinksAdapter) Component(form forms.FormBinder) {
	<h1 class="title text-h2">{ L(ctx).Gettext("Import Links from a GoodLinks export file") }</h1>
	<div class="prose mb-8">
		<p>
			{ L(ctx).Gettext(
				"Upload a JSON file obtained from your GoodLinks app.",
			) }
		</p>
	</div>
	@formViews{}.fileForm(form.(*FileImportForm))
}

